{
  "openapi": "3.1.0",
  "info": {
    "title": "Gorgias selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://{GORGIAS_SUBDOMAIN}.gorgias.com",
      "variables": {
        "GORGIAS_SUBDOMAIN": {
          "default": "your-account",
          "description": "Replace with your own authorized provider account value."
        }
      }
    }
  ],
  "paths": {
    "/api/customers": {
      "get": {
        "operationId": "gorgias_list_customers",
        "summary": "List a bounded page of support customers.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "gorgias_create_customer",
        "summary": "Create a customer with explicit contact channels; no message is sent.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "channels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "email"
                          ]
                        },
                        "address": {
                          "type": "string",
                          "format": "email"
                        },
                        "preferred": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "type",
                        "address",
                        "preferred"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "channels"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
